{
  "name": "@tiinex/verse-playthings",
  "version": "0.1.0",
  "private": false,
  "description": "Experimental Tiinex Playthings runtime and React Verse adapter over App read-only contracts.",
  "type": "module",
  "main": "./src/verses/playthings/index.mjs",
  "exports": {
    ".": "./src/verses/playthings/index.mjs",
    "./time": "./src/verses/playthings/runtime/time/index.mjs",
    "./story": "./src/verses/playthings/runtime/story/index.mjs",
    "./world": "./src/verses/playthings/runtime/world/index.mjs",
    "./observation": "./src/verses/playthings/runtime/observation/index.mjs",
    "./companions": "./src/verses/playthings/runtime/companions/index.mjs",
    "./scene": "./src/verses/playthings/runtime/scene/index.mjs",
    "./node": {
      "node": "./src/verses/playthings/node/index.mjs"
    },
    "./package.json": "./package.json",
    "./app": "./src/verses/playthings/app/index.mjs",
    "./react": "./src/verses/playthings/react/index.mjs"
  },
  "files": [
    "src/verses/playthings/**/*.mjs",
    "src/verses/playthings/**/README.md",
    "src/schemas/**/*.playthings.character.png",
    "src/schemas/**/*.playthings.verb.png",
    "src/schemas/**/*.playthings.blueprint.png",
    "src/schemas/**/*.playthings.portrait.png",
    "src/schemas/**/*.playthings.tiles.png",
    "src/schemas/**/*.playthings.structure.png",
    "src/schemas/**/*.playthings.props.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiinex/verse-playthings.git"
  },
  "scripts": {
    "test": "node tools/playthings/test-runtime.mjs",
    "test:runtime": "node tools/playthings/test-runtime.mjs",
    "test:package": "node tools/playthings/test-package.mjs",
    "check": "npm run test:runtime && npm run test:package && npm run test:release && npm run test:adapter",
    "prepublishOnly": "node tools/playthings/publish-guard.mjs",
    "release": "node tools/release.mjs preview",
    "release:preview": "node tools/release.mjs preview",
    "test:release": "node tools/playthings/test-release.mjs",
    "publish:bootstrap": "node tools/release.mjs bootstrap",
    "release:prepare": "node tools/release.mjs prepare",
    "release:publish": "node tools/release.mjs publish",
    "test:adapter": "node --test test/app-adapter.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiinex/core": "0.1.1",
    "react": "19.2.7",
    "@tiinex/app": "0.1.1"
  }
}
